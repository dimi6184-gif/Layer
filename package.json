{
  "name": "nexus-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "node apps/bot/dist/index.js",
    "postinstall": "prisma generate --schema=apps/bot/prisma/schema.prisma"
  }
}
