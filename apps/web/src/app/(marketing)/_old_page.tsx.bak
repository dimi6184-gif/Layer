              >
                Yearly
                <span className="text-xs bg-blue-500 text-white px-1.5 py-0.5 rounded-full font-semibold">-17%</span>
              </button>
            </div>
          </FadeUp>

          <div className="grid md:grid-cols-2 gap-4">
            {plans.map((plan, i) => (
              <FadeUp key={plan.name} delay={i * 0.1}>
                <div className={`relative p-8 rounded-2xl border h-full flex flex-col ${plan.popular ? "border-blue-500/40 bg-blue-500/[0.04]" : "border-white/5 bg-white/[0.02]"}`}>
                  {plan.popular && (
                    <div className="absolute -top-3 left-1/2 -translate-x-1/2">
                      <span className="px-3 py-1 bg-blue-600 text-white text-xs font-semibold rounded-full">Most popular</span>
                    </div>
                  )}
                  <div className="mb-6">
                    <div className="text-sm font-semibold text-white/60 mb-3">{plan.name}</div>
                    <div className="flex items-end gap-1 mb-2">
                      <span className="text-5xl font-bold">
                        ${plan.monthlyPrice === 0 ? "0" : yearly ? (plan.yearlyPrice / 12).toFixed(2) : plan.monthlyPrice}
                      </span>
                      <span className="text-white/30 text-sm mb-2">/month</span>
                    </div>
                    {yearly && plan.yearlyPrice > 0 && (
                      <div className="text-xs text-white/30">Billed ${plan.yearlyPrice}/year</div>
                    )}
                    <p className="text-sm text-white/40 mt-3">{plan.description}</p>
                  </div>

                  <ul className="space-y-3 mb-8 flex-1">
                    {plan.features.map((f) => (
                      <li key={f} className="flex items-center gap-2.5 text-sm text-white/60">
                        <Check className="w-4 h-4 text-blue-400 flex-shrink-0" />
                        {f}
                      </li>
                    ))}
                  </ul>

                  <Link
                    href={plan.ctaLink}
                    className={`w-full text-center py-3 rounded-full text-sm font-semibold transition-all ${plan.popular ? "bg-white text-black hover:bg-white/90" : "border border-white/10 text-white hover:bg-white/5"}`}
                  >
                    {plan.cta}
                  </Link>
                </div>
              </FadeUp>
            ))}
          </div>
        </div>
      </section>

      {/* ── SECURITY BANNER ─────────────────────────────────────────────── */}
      <section className="py-6 px-6 border-t border-white/5 bg-white/[0.01]">
        <div className="max-w-5xl mx-auto flex items-center justify-center gap-3 text-sm text-white/40">
          <ShieldCheck className="w-4 h-4 text-blue-500 flex-shrink-0" />
          <p className="text-center">
            <strong className="text-white/60">After the Double Counter breach (28M users exposed):</strong>{" "}
            Layer collects zero emails, zero IPs — verification stays in Discord.{" "}
            <Link href="/security" className="text-blue-400 hover:text-blue-300 transition-colors underline underline-offset-2">Learn more</Link>
          </p>
        </div>
      </section>

      {/* ── FAQ ─────────────────────────────────────────────────────────── */}
      <section className="py-32 px-6 border-t border-white/5">
        <div className="max-w-2xl mx-auto">
          <FadeUp className="text-center mb-16">
            <p className="text-xs text-white/30 uppercase tracking-widest mb-4">FAQ</p>
            <h2 className="text-4xl md:text-5xl font-bold tracking-tight">
              Questions about
              <br />
              <span className="text-white/30">Layer, answered.</span>
            </h2>
            <p className="text-white/40 text-sm mt-4">
              Learn how Layer protects your server, handles your data, and supports your community.
            </p>
          </FadeUp>

          <div className="space-y-2">
            {faqs.map((faq, i) => (
              <FadeUp key={i} delay={i * 0.04}>
                <div className={`rounded-2xl border transition-all ${openFaq === i ? "border-white/10 bg-white/[0.04]" : "border-white/5 bg-white/[0.02]"}`}>
                  <button
                    onClick={() => setOpenFaq(openFaq === i ? null : i)}
                    className="w-full flex items-center justify-between p-5 text-left"
                  >
                    <span className="font-medium text-sm pr-4">{faq.q}</span>
                    <span className="flex-shrink-0 w-5 h-5 rounded-full border border-white/10 flex items-center justify-center">
                      {openFaq === i
                        ? <Minus className="w-3 h-3 text-white/50" />
                        : <Plus className="w-3 h-3 text-white/50" />
                      }
                    </span>
                  </button>
                  <AnimatePresence>
                    {openFaq === i && (
                      <motion.div
                        initial={{ height: 0, opacity: 0 }}
                        animate={{ height: "auto", opacity: 1 }}
                        exit={{ height: 0, opacity: 0 }}
                        transition={{ duration: 0.3, ease: [0.22, 1, 0.36, 1] }}
                        className="overflow-hidden"
                      >
                        <p className="px-5 pb-5 text-sm text-white/40 leading-relaxed">{faq.a}</p>
                      </motion.div>
                    )}
                  </AnimatePresence>
                </div>
              </FadeUp>
            ))}
          </div>
        </div>
      </section>

      {/* ── FOOTER CTA ──────────────────────────────────────────────────── */}
      <section className="py-32 px-6 border-t border-white/5">
        <div className="max-w-3xl mx-auto text-center">
          <FadeUp>
            <h2 className="text-4xl md:text-6xl font-bold tracking-tight mb-6">
              You've seen how Layer works.
              <br />
              <span className="text-white/30">Now put it to work.</span>
            </h2>
            <p className="text-white/40 text-lg mb-10">
              Add it to your server in seconds, configure what you need, and let it run.
            </p>
            <Link
              href="/dashboard"
              className="inline-flex items-center gap-2 px-8 py-4 bg-white text-black font-semibold rounded-full text-base hover:bg-white/90 transition-all hover:scale-[1.02]"
            >
              Add to Discord
              <ArrowRight className="w-4 h-4" />
            </Link>
          </FadeUp>
        </div>
      </section>

      {/* ── FOOTER ──────────────────────────────────────────────────────── */}
      <footer className="border-t border-white/5 px-6 py-16">
        <div className="max-w-6xl mx-auto">
          <div className="grid grid-cols-2 md:grid-cols-4 gap-10 mb-16">
            {/* Brand */}
            <div className="col-span-2 md:col-span-1">
              <Link href="/" className="flex items-center gap-2.5 mb-3">
                <Image src="/logo_v3.png" alt="Layer" width={24} height={24} />
                <span className="font-semibold">Layer</span>
              </Link>
              <p className="text-xs text-white/30 leading-relaxed">The last Discord bot you'll ever need.</p>
            </div>

            {/* Product */}
            <div>
              <p className="text-xs font-semibold text-white/50 uppercase tracking-widest mb-4">Product</p>
              <ul className="space-y-3 text-sm text-white/30">
                {[["Features", "#features"], ["How it works", "#how-it-works"], ["Pricing", "#pricing"], ["Security", "/security"], ["Commands", "/commands"]].map(([label, href]) => (
                  <li key={label}><Link href={href} className="hover:text-white transition-colors">{label}</Link></li>
                ))}
              </ul>
            </div>

            {/* Legal */}
            <div>
              <p className="text-xs font-semibold text-white/50 uppercase tracking-widest mb-4">Legal</p>
              <ul className="space-y-3 text-sm text-white/30">
                {[["Privacy Policy", "/privacy"], ["Terms of Service", "/terms"], ["Cookie Policy", "/privacy"]].map(([label, href]) => (
                  <li key={label}><Link href={href} className="hover:text-white transition-colors">{label}</Link></li>
                ))}
              </ul>
            </div>

            {/* Support */}
            <div>
              <p className="text-xs font-semibold text-white/50 uppercase tracking-widest mb-4">Support</p>
              <ul className="space-y-3 text-sm text-white/30">
                {[["Discord Server", "/dashboard"], ["Documentation", "/commands"], ["Contact", "/dashboard"]].map(([label, href]) => (
                  <li key={label}><Link href={href} className="hover:text-white transition-colors">{label}</Link></li>
                ))}
              </ul>
            </div>
          </div>

          {/* Bottom bar */}
          <div className="flex flex-col md:flex-row items-center justify-between gap-4 pt-8 border-t border-white/5">
            <p className="text-xs text-white/20">© 2026 Layer. All rights reserved.</p>
            <p className="text-xs text-white/20">Made with ❤️ by the Layer Team</p>
          </div>
        </div>
      </footer>

    </div>
  );
}
